# Keys and remittance targets for the eSahod chipnet scripts.
#
# Copy to scripts/esahod/.env and fill in. That file is gitignored, and
# scripts/esahod/lib/config.ts loads it automatically — so `npm run esahod:relay`
# and friends work with no exports. An already-exported variable still wins.
#
# Generate a fresh set with: npm run esahod:keys
#
# CHIPNET ONLY. These coins have no value. Do not put a mainnet key here — and
# note the keeper key below is a FEE PAYER: the covenant pins every payee and
# amount, so stealing it wastes fees and takes nothing.

# Pays transaction fees. Held by the relay and the daemon.
ESAHOD_KEEPER_WIF=

# Signs sweepLapsedNca only. Part of both contract addresses, so it is required
# even by scripts that never sign with it.
ESAHOD_OFFICER_WIF=

# Signs amend(). Rewrites pay terms, so this one IS privileged — leave it unset
# and the relay serves payroll only.
ESAHOD_HR_WIF=

# The four remittance destinations the treasury covenant is pinned to.
ESAHOD_SSS_PKH=
ESAHOD_PHIC_PKH=
ESAHOD_HDMF_PKH=
ESAHOD_BIR_PKH=

# Optional — read from deployment.json when absent.
# ESAHOD_HR_PKH=
# ESAHOD_REMIT_CONFIG_HASH=

# Who may call the relay, and where it listens.
# ESAHOD_RELAY_PORT=8787
# ESAHOD_RELAY_ORIGINS=http://localhost:5173,http://localhost:4173

# The relay verifies callers against Supabase. Anon key only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
