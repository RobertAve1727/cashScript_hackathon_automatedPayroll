# Point the app at a deployed eSahod covenant pair on chipnet.
#
# Copy to .env.local and fill in from scripts/esahod/deployment.json, which
# `npx tsx scripts/esahod/01-deploy.ts` writes after a successful deploy.
#
# Leave these unset and the app runs on its in-memory demo chain instead —
# the chipnet path is opt-in, so a fresh clone needs no setup. All four are
# required together; any missing value falls back to the demo chain.
#
# Reads only. Running payroll and amending records still happen from
# scripts/esahod/, because both need a key to sign a fee input and the
# browser is the wrong place to hold one.

VITE_ESAHOD_TREASURY_ADDRESS=
VITE_ESAHOD_VAULT_ADDRESS=
VITE_ESAHOD_PESO_CATEGORY=
VITE_ESAHOD_EMPLOYMENT_CATEGORY=

# Optional — Paytaca WalletConnect on the Employee screen.
# VITE_WC_PROJECT_ID=

# ── Supabase (optional) ────────────────────────────────────────────────
# The HRIS side: accounts, employee names, attendance and overtime. Leave
# unset and the app runs on in-memory demo data instead.
#
# Only the ANON key belongs here. It is designed to ship in a browser and
# grants nothing on its own, because every table has row-level security and
# the policies key off the signed-in user. The service_role key bypasses RLS
# entirely and must never reach the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
