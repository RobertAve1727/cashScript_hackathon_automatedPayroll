# Point the app at a deployed eSahod covenant pair on chipnet.
#
# Copy to .env.local and fill in from scripts/esahod/deployment.json, which
# `npx tsx scripts/esahod/01-deploy.ts` writes after a successful deploy.
#
# Leave these unset and the app runs on its in-memory demo chain instead —
# the chipnet path is opt-in, so a fresh clone needs no setup. All four are
# required together; any missing value falls back to the demo chain.
#
# These four are read-only. To let the app WRITE to the chain, also set
# VITE_ESAHOD_RELAY_URL below.

VITE_ESAHOD_TREASURY_ADDRESS=
VITE_ESAHOD_VAULT_ADDRESS=
VITE_ESAHOD_PESO_CATEGORY=
VITE_ESAHOD_EMPLOYMENT_CATEGORY=

# The treasury's period-zero, copied from deployment.json. This is the number
# the covenant checks tx.time against, so "is payroll due" is only truthful
# with it set. Unset, the app back-dates a demo clock and says so.
VITE_ESAHOD_GENESIS_TIME=

# The treasury's period length in seconds, from deployment.json. It is a
# constructor argument of the covenant, so it belongs to the TREASURY, not to
# the employee — an employee's HRIS cadence decides which treasury pays them,
# not how fast this one's clock ticks.
VITE_ESAHOD_PERIOD_SECONDS=

# ── The keeper relay (optional) ────────────────────────────────────────
# Where the app sends payroll and amendment requests. Start it with:
#   npx tsx scripts/esahod/keeper-relay.ts
#
# A transaction needs a fee input, and fee inputs are ordinary coins that must
# be signed — the covenant forbids the treasury or the NFT from covering it, so
# that a "payroll" cannot drain the treasury's BCH as fees. The browser is the
# wrong place for that key, so the relay holds it.
#
# What that key can do is bounded by the covenant, not by trusting the relay:
# every payee, category and amount is pinned. A stolen keeper key wastes fee
# coins and takes nothing. Leave this unset and the app reads the chain without
# writing to it.
VITE_ESAHOD_RELAY_URL=

# Optional — Paytaca WalletConnect on the Employee screen.
# VITE_WC_PROJECT_ID=

# ── Supabase (optional) ────────────────────────────────────────────────
# The HRIS side: accounts, employee names, attendance and overtime. Leave
# unset and the app runs on in-memory demo data instead.
#
# Only the ANON key belongs here. It is designed to ship in a browser and
# grants nothing on its own, because every table has row-level security and
# the policies key off the signed-in user. The service_role key bypasses RLS
# entirely and must never reach the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
