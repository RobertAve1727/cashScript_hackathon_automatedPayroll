# Copy to .env and adjust. Every variable is optional; the defaults run a safe,
# offline demo against an in-process mock chain.

# mainnet | testnet | regtest        (default: testnet)
PAYROLL_NETWORK=testnet

# mock | electrum                    (default: mock)
#   mock     — in-process UTXO set. No network, no real money.
#   electrum — a real Electrum server on PAYROLL_NETWORK. Requires the keys below.
PAYROLL_CHAIN=mock

# memory | file                      (default: file)
PAYROLL_PERSISTENCE=file
PAYROLL_DATA_DIR=.payroll-data

# Required when PAYROLL_CHAIN=electrum.
# The operator key signs every payroll run — treat it as a hot key.
# PAYROLL_OPERATOR_WIF=
# The treasurer can always sweep the treasury. Store the KEY cold; only its
# hash160 (40 hex characters) goes here.
# PAYROLL_TREASURER_PKH=

# Blocks a treasury coin must age before it can be spent again.
# This is the on-chain payroll rate limit. 1 for demos; ~4032 is roughly a
# fortnight at 10-minute blocks.       (default: 1)
PAYROLL_PAYOUT_INTERVAL_BLOCKS=1

# Fee rate in satoshis per byte.       (default: 1)
PAYROLL_FEE_RATE=1
